{
  "manifest_version": 3,
  "name": "Dodown Browser Extension",
  "version": "1.0.0",
  "description": "Send browser downloads directly to Dodown — fast, multi-protocol desktop downloader with the Totone Studio UI.",
  "homepage_url": "https://averybeuth.xyz",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Dodown",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "downloads",
    "storage",
    "contextMenus",
    "notifications"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ]
}
